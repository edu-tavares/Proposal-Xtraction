# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- LLM (trocar de provedor = trocar estas duas linhas) ---
# Exemplos de LLM_MODEL:
#   anthropic/claude-opus-5
#   openai/gpt-4o
#   gemini/gemini-2.0-flash
#   mistral/pixtral-large-latest
#   ollama/llama3.2-vision      (local; use LLM_API_BASE=http://localhost:11434)
#   openrouter/anthropic/claude-opus-5
LLM_MODEL=anthropic/claude-opus-5
LLM_API_KEY=

# Opcional: endpoint alternativo (proxy, OpenRouter, vLLM, Ollama, Azure...)
LLM_API_BASE=

LLM_MAX_OUTPUT_TOKENS=8000
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=180
LLM_NUM_RETRIES=2

# --- Limites de processamento ---
MAX_FILE_MB=20
MAX_PAGES=15
PDF_RENDER_DPI=150
IMAGE_MAX_DIMENSION=2000

# --- Logs ---
LOG_LEVEL=INFO
